v {xschem version=3.4.8 file_version=1.3}
K {type=subcircuit
format="@name @pinlist @symname"
template="name=x1"}
B 4 -100 -60 100 120 {fill=false}
T {slow_nand} -80 -25 0 0 0.22 0.22 {}
T {@name} -90 -85 0 0 0.2 0.2 {}
B 5 137.5 -42.5 142.5 -37.5 {name=Y dir=out}
L 7 140 -40 100 -40 {}
T {Y} 60 -47 0 0 0.18 0.18 {}
B 5 -142.5 -42.5 -137.5 -37.5 {name=A dir=in}
L 7 -140 -40 -100 -40 {}
T {A} -92 -47 0 0 0.18 0.18 {}
B 5 -142.5 -2.5 -137.5 2.5 {name=B dir=in}
L 7 -140 0 -100 0 {}
T {B} -92 -7 0 0 0.18 0.18 {}
B 5 -142.5 37.5 -137.5 42.5 {name=VDD dir=inout}
L 7 -140 40 -100 40 {}
T {VDD} -92 33 0 0 0.18 0.18 {}
B 5 -142.5 77.5 -137.5 82.5 {name=GND dir=inout}
L 7 -140 80 -100 80 {}
T {GND} -92 73 0 0 0.18 0.18 {}
